# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Python bytecode cache
__pycache__/
*.pyc

# maturin developでビルドされるPython拡張モジュール本体（環境・OS依存のバイナリ）
python_package/econometricsmodels/*.so
python_package/econometricsmodels/*.pyd

# mkdocs buildの出力（docs/mkdocs.ymlのsite_dir）。GitHub Pagesへのデプロイはcd_docs.yml
# （別issue）でビルドして公開する想定で、リポジトリにはコミットしない。
/site/

# performance/compare_<method>.py が生成する生のベンチマーク結果JSON（実行環境依存で
# 再現性が低く、サマリーは docs/performance/ 配下のMarkdownに記録するためコミット不要。
# Issue #28参照）。出力先は docs/performance/results/<method>.json。
docs/performance/results/*.json
# benchmark_performance.ymlがリポジトリルートに書き出す一時結果（CIではartifactに
# アップロードするのみ、ローカルで走らせた場合の取り込み事故防止）。
/results.json

# Claude Codeの個人ローカル設定（settings.jsonはコミット対象、settings.local.jsonは個人用）
.claude/settings.local.json

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
