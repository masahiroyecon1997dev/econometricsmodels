{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docs: sync dependencies",
      "type": "shell",
      "command": "uv sync --group test --group docs",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "docs: build extension",
      "type": "shell",
      "command": "uv run --group docs maturin develop",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "docs: serve (mkdocs)",
      "type": "shell",
      "command": "uv run --group docs mkdocs serve --config-file docs/mkdocs.yml --dev-addr 0.0.0.0:8000",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "mkdocs",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building documentation",
          "endsPattern": "Serving on|Reloading browsers"
        }
      }
    },
    {
      "label": "docs: serve with setup",
      "dependsOrder": "sequence",
      "dependsOn": [
        "docs: sync dependencies",
        "docs: build extension",
        "docs: serve (mkdocs)"
      ],
      "problemMatcher": []
    },
    {
      "label": "docs: build (mkdocs)",
      "type": "shell",
      "command": "uv run --group docs mkdocs build --config-file docs/mkdocs.yml",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
